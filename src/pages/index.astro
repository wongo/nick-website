---
import BaseLayout from '../layouts/BaseLayout.astro';
import TerminalText from '../components/TerminalText.astro';
import SkillRadar from '../components/SkillRadar.astro';
import ProjectCard from '../components/ProjectCard.astro';

// Typing lines for hero
const typingLines = [
  'nick --about',
  'Software Engineer @ Ubitus',
  'Tokyo, Japan',
  'Building tools & shipping features',
  'Astro enthusiast',
  'AI automation tinkerer',
];

// Fetch top starred public repos
const res = await fetch('https://api.github.com/users/wongo/repos?sort=stars&direction=desc&per_page=6&type=public');
const repos = res.ok ? await res.json() : [];

const featuredRepos = repos
  .filter((r: any) => !r.name.includes('.github') && !r.name.includes('backup'))
  .slice(0, 3)
  .map((r: any) => ({
    name: r.name,
    description: r.description,
    url: r.html_url,
    stars: r.stargazers_count,
    language: r.language,
    topics: r.topics || [],
  }));
---

<BaseLayout title="Nick · nickdevlab">

  <!-- ═══════════════════════════════════════
       HERO
  ═══════════════════════════════════════ -->
  <section class="hero">
    <!-- KITT Dashboard Panel -->
    <div class="kitt-panel">
      <div class="panel-header">
        <span class="panel-title">K.N.I.T.T. DASHBOARD</span>
        <span class="panel-status">
          <span class="panel-dot"></span>SYSTEM ONLINE
        </span>
      </div>

      <div class="kitt-body">
        <!-- Left: ASCII art + info -->
        <div class="kitt-left">
          <pre class="kitt-ascii">
+------------------------------------------+
|  ██████╗ ██████╗ ███╗   ██╗███████╗    |
|  ██╔════╝██╔═══██╗████╗  ██║██╔════╝    |
|  ╚█████╗ ██║   ██║██╔██╗ ██║█████╗      |
|   ╚═══██╗██║   ██║██║╚██╗██║██╔══╝      |
|  ██████╔╝╚██████╔╝██║ ╚████║███████╗   |
|  ╚═════╝  ╚═════╝ ╚═╝  ╚═══╝╚══════╝   |
+------------------------------------------+
          </pre>
          <div class="kitt-status-grid">
            <div class="status-item">
              <span class="status-label">STATUS</span>
              <span class="status-val available">AVAILABLE</span>
            </div>
            <div class="status-item">
              <span class="status-label">LOCATION</span>
              <span class="status-val">TOKYO, JP</span>
            </div>
            <div class="status-item">
              <span class="status-label">ROLE</span>
              <span class="status-val">SWE ENGINEER</span>
            </div>
            <div class="status-item">
              <span class="status-label">FOUNDATION</span>
              <span class="status-val">UBITUS INC.</span>
            </div>
          </div>
        </div>

        <!-- Right: Terminal text -->
        <div class="kitt-right">
          <div class="terminal-label">// IDENTITY</div>
          <TerminalText lines={typingLines} />
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="hero-cta">
      <a href="https://github.com/wongo" class="btn btn-kitt" target="_blank" rel="noopener">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
        GitHub Profile
      </a>
      <a href="/projects" class="btn btn-ghost">View Projects</a>
      <a href="/blog" class="btn btn-ghost">Blog</a>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       SKILLS RADAR
  ═══════════════════════════════════════ -->
  <section>
    <div class="container">
      <p class="section-tag">// TECH_PROFILE</p>
      <h2 class="section-title">Skills</h2>
      <div class="skills-layout">
        <div class="skills-text">
          <p class="skills-intro">Full-stack engineer with a bias for shipping. From kernel modules to React components, here's where I spend my time.</p>
          <div class="skills-list">
            {[
              { cat: 'Frontend', items: ['TypeScript', 'React', 'Astro', 'CSS/SCSS'] },
              { cat: 'Backend', items: ['Node.js', 'Python', 'PostgreSQL', 'REST APIs'] },
              { cat: 'DevOps', items: ['Docker', 'CI/CD', 'GitHub Actions', 'Linux'] },
              { cat: 'AI/ML', items: ['LLM APIs', 'MCP', 'Prompt Engineering'] },
              { cat: 'Game', items: ['Unity (C#)', 'Flutter', 'Godot'] },
              { cat: 'Mobile', items: ['Flutter/Dart', 'React Native'] },
            ].map(({ cat, items }) => (
              <div class="skill-cat">
                <span class="skill-cat-label">{cat}</span>
                <div class="skill-items">
                  {items.map(item => <span class="tag">{item}</span>)}
                </div>
              </div>
            ))}
          </div>
        </div>
        <div class="skills-radar">
          <SkillRadar size={300} />
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       FEATURED PROJECTS
  ═══════════════════════════════════════ -->
  <section>
    <div class="container">
      <p class="section-tag">// PROJECTS</p>
      <h2 class="section-title">Featured Work</h2>
      {featuredRepos.length > 0 ? (
        <div class="projects-grid">
          {featuredRepos.map(repo => (
            <ProjectCard {...repo} />
          ))}
        </div>
      ) : (
        <div class="panel" style="padding:2rem;text-align:center;">
          <span class="mono muted">// Unable to load projects from GitHub</span>
        </div>
      )}
      <div style="margin-top: 2rem; text-align: center;">
        <a href="/projects" class="btn btn-ghost">View All Projects &rarr;</a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       GAMES
  ═══════════════════════════════════════ -->
  <section>
    <div class="container">
      <p class="section-tag">// FUN</p>
      <h2 class="section-title">Play</h2>
      <div class="projects-grid">
        <a href="/tetris.html" class="project-card glow-hover">
          <div class="pc-banner" style="height:140px;display:flex;align-items:center;justify-content:center;background:var(--bg3);">
            <span style="font-size:3rem;">🎮</span>
          </div>
          <div class="pc-header">
            <span class="pc-name">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" style="opacity:0.5"><path d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm-2 15l-5-5 1.41-1.41L10 14.17l7.59-7.59L19 8l-9 9z"/></svg>
              KITT RIS
            </span>
            <span class="pc-stars" style="color:var(--accent);">▶ PLAY</span>
          </div>
          <p class="pc-desc">Classic Tetris with KITT/Knight Rider theming. BGM, particle explosions, and screen shake. 100% vanilla HTML5.</p>
          <div class="pc-footer">
            <span class="pc-lang"><span class="lang-dot" style="background:var(--accent)"></span>HTML5 + Canvas + Web Audio</span>
          </div>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════
       BLOG PREVIEW
  ═══════════════════════════════════════ -->
  <section>
    <div class="container">
      <p class="section-tag">// BLOG</p>
      <h2 class="section-title">Recent Posts</h2>
      <div class="panel" style="padding: 2rem; text-align: center;">
        <p class="mono muted">// Blog posts coming soon. Manual posts from Facebook go here.</p>
        <a href="/blog" class="btn btn-ghost" style="margin-top: 1rem;">View All Posts &rarr;</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
/* ── Hero ── */
.hero {
  padding: 5rem 0 4rem;
  border-bottom: 1px solid var(--border);
}

.kitt-panel {
  background: var(--bg2);
  border: 1px solid var(--border2);
  border-radius: var(--radius);
  overflow: hidden;
  max-width: 900px;
  margin: 0 auto 3rem;
  box-shadow: 0 0 40px rgba(230, 57, 70, 0.08);
}

.panel-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 0.6rem 1.25rem;
  background: var(--bg3);
  border-bottom: 1px solid var(--border);
  font-family: var(--font-mono);
  font-size: 0.65rem;
}

.panel-title { color: var(--accent); letter-spacing: 0.1em; font-weight: 600; }
.panel-status { color: var(--text-muted); display: flex; align-items: center; gap: 6px; }
.panel-dot {
  display: inline-block;
  width: 6px; height: 6px;
  border-radius: 50%;
  background: var(--green);
  animation: blink 1.8s ease-in-out infinite;
}
@keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.2; } }

.kitt-body {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0;
}

.kitt-left {
  padding: 1.5rem;
  border-right: 1px solid var(--border);
  display: flex;
  flex-direction: column;
  gap: 1.25rem;
}

.kitt-ascii {
  font-family: var(--font-mono);
  font-size: 0.55rem;
  line-height: 1.2;
  color: var(--accent);
  white-space: pre;
  text-shadow: 0 0 8px rgba(230, 57, 70, 0.3);
}

.kitt-status-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 0.75rem;
}

.status-item {
  display: flex;
  flex-direction: column;
  gap: 0.15rem;
}

.status-label {
  font-family: var(--font-mono);
  font-size: 0.58rem;
  color: var(--text-muted);
  letter-spacing: 0.1em;
}

.status-val {
  font-family: var(--font-mono);
  font-size: 0.72rem;
  font-weight: 600;
  color: var(--text);
}

.status-val.available {
  color: var(--green);
  animation: pulse 2s ease-in-out infinite;
}
@keyframes pulse { 0%, 100% { text-shadow: 0 0 4px rgba(34, 197, 94, 0.4); } 50% { text-shadow: 0 0 10px rgba(34, 197, 94, 0.8); } }

.kitt-right {
  padding: 1.5rem;
  display: flex;
  flex-direction: column;
  gap: 0.75rem;
}

.terminal-label {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: var(--accent);
  letter-spacing: 0.08em;
}

/* CTA */
.hero-cta {
  display: flex;
  justify-content: center;
  gap: 0.8rem;
  flex-wrap: wrap;
}

/* Skills */
.skills-layout {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 3rem;
  align-items: center;
}

.skills-intro {
  color: var(--text-muted);
  font-size: 0.95rem;
  line-height: 1.7;
  margin-bottom: 1.5rem;
}

.skills-list {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 1.25rem;
}

.skill-cat {
  display: flex;
  flex-direction: column;
  gap: 0.4rem;
}

.skill-cat-label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--accent);
  letter-spacing: 0.08em;
  font-weight: 600;
}

.skill-items {
  display: flex;
  flex-wrap: wrap;
  gap: 0.3rem;
}

/* Projects */
.projects-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
  gap: 1rem;
}

@media (max-width: 768px) {
  .kitt-body { grid-template-columns: 1fr; }
  .kitt-left { border-right: none; border-bottom: 1px solid var(--border); }
  .skills-layout { grid-template-columns: 1fr; }
  .skills-radar { order: -1; }
  .skills-list { grid-template-columns: 1fr; }
}
</style>
