---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Nick — Software Engineer & Builder · nickdevlab">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-eyebrow">
      <span class="dot"></span>
      <span class="status-text">Available for projects</span>
    </div>
    <h1 class="hero-title">
      Hi, I'm <span class="name">Nick</span>.
    </h1>
    <p class="hero-sub">
      Software Engineer&nbsp;&middot;&nbsp;Based in Tokyo<br />
      Building tools, automations, and things that work.
    </p>
    <div class="hero-links">
      <a href="https://github.com/wongo" class="btn-primary" target="_blank" rel="noopener">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
        GitHub
      </a>
      <a href="#contact" class="btn-secondary">Get in touch</a>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <p class="section-tag">About</p>
    <h2>About Me</h2>
    <div class="about-grid">
      <div class="about-text">
        <p>
          I'm Nick, a Taiwan-born software engineer now based in Tokyo. I build everything from system-level code to user-facing interfaces — TypeScript, Python, C++, Dart, you name it.
        </p>
        <p>
          I enjoy writing tools, solving problems, and making complex things simple. Currently working at Ubitus on cloud gaming platform infrastructure, while maintaining a range of personal projects on the side.
        </p>
        <p>
          Familiar with Astro, React, Node.js, PostgreSQL, Docker, Flutter, and Unity. Occasionally tinker with AI-related projects.
        </p>
      </div>
      <div class="about-stack">
        <p class="stack-label">Tech Stack</p>
        <div class="stack-tags">
          {['TypeScript', 'Python', 'C++', 'Dart', 'Astro', 'React', 'Node.js', 'PostgreSQL', 'Docker', 'Flutter', 'Unity'].map(t => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact">
    <p class="section-tag">Contact</p>
    <h2>Get In Touch</h2>
    <div class="contact-grid">
      <div class="contact-item">
        <span class="contact-label">Email</span>
        <a href="mailto:wongo.w@gmail.com">wongo.w@gmail.com</a>
      </div>
      <div class="contact-item">
        <span class="contact-label">GitHub</span>
        <a href="https://github.com/wongo" target="_blank" rel="noopener">@wongo</a>
      </div>
      <div class="contact-item">
        <span class="contact-label">Telegram</span>
        <a href="https://t.me/nickwongo" target="_blank" rel="noopener">@nickwongo</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* HERO */
  .hero {
    max-width: 900px;
    margin: 0 auto;
    padding: 7rem 1.5rem 5rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-eyebrow {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #22c55e;
    box-shadow: 0 0 8px #22c55e;
    animation: pulse 2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; }
    50% { opacity: 0.4; }
  }

  .hero-title {
    font-size: clamp(2.5rem, 6vw, 4rem);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1.1;
    margin-bottom: 1.2rem;
  }

  .name {
    color: var(--accent);
  }

  .hero-sub {
    font-size: 1.1rem;
    color: var(--text-muted);
    line-height: 1.7;
    margin-bottom: 2.5rem;
  }

  .hero-links {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: var(--accent);
    color: #fff;
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    transition: background 0.2s, transform 0.1s;
  }

  .btn-primary:hover {
    background: var(--accent2);
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: transparent;
    color: var(--text);
    padding: 0.65rem 1.4rem;
    border-radius: 6px;
    font-size: 0.9rem;
    font-weight: 500;
    border: 1px solid var(--border);
    transition: border-color 0.2s, transform 0.1s;
  }

  .btn-secondary:hover {
    border-color: var(--text-muted);
    transform: translateY(-1px);
  }

  /* ABOUT */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: start;
  }

  .about-text p {
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .about-text p:last-child {
    margin-bottom: 0;
  }

  .about-stack {
    min-width: 160px;
  }

  .stack-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    background: var(--bg2);
    border: 1px solid var(--border);
    padding: 0.25rem 0.6rem;
    border-radius: 4px;
    color: var(--text-muted);
  }

  /* CONTACT */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contact-label {
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--text-muted);
  }

  .contact-item a {
    font-size: 0.95rem;
    color: var(--text);
    transition: color 0.2s;
  }

  .contact-item a:hover {
    color: var(--accent);
  }

  /* RESPONSIVE */
  @media (max-width: 640px) {
    .about-grid {
      grid-template-columns: 1fr;
    }
    .about-stack {
      order: -1;
    }
    .hero {
      padding: 5rem 1.5rem 3.5rem;
    }
  }
</style>
