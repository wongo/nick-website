---
import BaseLayout from '../layouts/BaseLayout.astro';

const nickAscii = ` _   ______________ __
 / | / /  _/ ____/ //_/
 /  |/ // // /   / ,<
 / /|  // // /___/ /| |
/_/ |_/___/\\____/_/ |_|`;
---

<BaseLayout title="Nick · nickdevlab">

  <!-- HERO -->
  <section class="hero">
    <div class="hero-inner">
      <!-- KITT Dashboard Frame -->
      <div class="kitt-frame">
        <pre class="kitt-ascii"><span class="kitt-title">K.N.I.T.T.</span>          <span class="sys">KNIGHT INDUSTRIES</span>          <span class="sys">TURBO BOOST: READY</span>
<span class="scanner">▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓▓</span>  <span class="blink">●</span> SCAN</pre>
        <div class="kitt-body">
          <div class="kitt-sidebar">
            <div class="gauge">
              <span class="gauge-label">SPD</span>
              <div class="gauge-bar"><div class="gauge-fill" style="width:72%"></div></div>
            </div>
            <div class="gauge">
              <span class="gauge-label">SYS</span>
              <div class="gauge-bar"><div class="gauge-fill green" style="width:95%"></div></div>
            </div>
            <div class="gauge">
              <span class="gauge-label">AI</span>
              <div class="gauge-bar"><div class="gauge-fill accent" style="width:88%"></div></div>
            </div>
          </div>

          <div class="kitt-center">
            <pre class="nick-ascii">{nickAscii}</pre>
            <div class="status-line">
              <span class="status-tag available">● AVAILABLE</span>
              <span class="sep">|</span>
              <span class="location">TOKYO, JP</span>
              <span class="sep">|</span>
              <span class="role">SOFTWARE ENGINEER</span>
            </div>
          </div>

          <div class="kitt-sidebar right">
            <div class="gauge">
              <span class="gauge-label">RAM</span>
              <div class="gauge-bar"><div class="gauge-fill" style="width:60%"></div></div>
            </div>
            <div class="gauge">
              <span class="gauge-label">CPU</span>
              <div class="gauge-bar"><div class="gauge-fill green" style="width:83%"></div></div>
            </div>
            <div class="gauge">
              <span class="gauge-label">KWH</span>
              <div class="gauge-bar"><div class="gauge-fill accent" style="width:100%"></div></div>
            </div>
          </div>
        </div>
        <pre class="kitt-footer"><span class="kitt-title">K.N.I.T.T.</span>          <span class="sys">v3.2.1</span>          <span class="sys">INTERFACE: ACTIVE</span></pre>
      </div>

      <!-- Action buttons -->
      <div class="hero-links">
        <a href="https://github.com/wongo" class="btn-primary" target="_blank" rel="noopener">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
          GitHub
        </a>
        <a href="#about" class="btn-secondary">About Me</a>
        <a href="#contact" class="btn-secondary">Contact</a>
      </div>
    </div>
  </section>

  <!-- ABOUT -->
  <section id="about">
    <p class="section-tag">// ABOUT</p>
    <h2>About</h2>
    <div class="about-grid">
      <div class="about-text">
        <p>
          在東京生活的台灣軟體工程師。從系統底層到前端介面都有經驗，語言涵蓋 TypeScript、Python、C++、Dart。
        </p>
        <p>
          喜歡寫工具、解決問題、把複雜的東西變簡單。目前在 Ubitus 參與雲端遊戲平台開發，同時持續維護各類業餘專案。
        </p>
        <p>
          熟悉 Astro、React、Node.js、PostgreSQL、Docker，也寫過 Flutter App 和 Unity 小遊戲。業餘時間研究 AI 相關應用。
        </p>
      </div>
      <div class="about-stack">
        <p class="stack-label">// TECH_STACK</p>
        <div class="stack-tags">
          {['TypeScript', 'Python', 'C++', 'Dart', 'Astro', 'React', 'Node.js', 'PostgreSQL', 'Docker', 'Flutter', 'Unity'].map(t => (
            <span class="tag">{t}</span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- CONTACT -->
  <section id="contact">
    <p class="section-tag">// CONTACT</p>
    <h2>Get In Touch</h2>
    <div class="contact-grid">
      <div class="contact-item">
        <span class="contact-label">Email</span>
        <a href="mailto:wongo.w@gmail.com">wongo.w@gmail.com</a>
      </div>
      <div class="contact-item">
        <span class="contact-label">GitHub</span>
        <a href="https://github.com/wongo" target="_blank" rel="noopener">@wongo</a>
      </div>
      <div class="contact-item">
        <span class="contact-label">Telegram</span>
        <a href="https://t.me/nickwongo" target="_blank" rel="noopener">@nickwongo</a>
      </div>
    </div>
  </section>

</BaseLayout>

<style>
  /* ── HERO ────────────────────────────────── */
  .hero {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 1.5rem 3.5rem;
    border-bottom: 1px solid var(--border);
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2.5rem;
  }

  /* KITT ASCII frame */
  .kitt-frame {
    width: 100%;
    max-width: 740px;
    background: #0d0d14;
    border: 2px solid #2a2a3a;
    border-radius: 8px;
    overflow: hidden;
    box-shadow:
      0 0 0 1px #1a1a28,
      0 0 30px rgba(230, 57, 70, 0.08),
      inset 0 0 60px rgba(0,0,0,0.4);
  }

  .kitt-ascii,
  .kitt-footer {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    line-height: 1.4;
    padding: 0.6rem 1rem;
    background: #111118;
    border-bottom: 1px solid #1e1e2e;
    white-space: pre;
    overflow: hidden;
    display: block;
  }

  .kitt-footer {
    border-bottom: none;
    border-top: 1px solid #1e1e2e;
  }

  .kitt-body {
    display: grid;
    grid-template-columns: 1fr 2fr 1fr;
    gap: 0;
    padding: 0.8rem 1rem;
    align-items: center;
  }

  .kitt-sidebar {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .nick-ascii {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    line-height: 1.35;
    color: var(--accent);
    text-align: center;
    white-space: pre;
    margin-bottom: 0.6rem;
  }

  .status-line {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 0.7rem;
    font-size: 0.7rem;
    font-family: var(--font-mono);
    flex-wrap: wrap;
  }

  .status-tag.available {
    color: #22c55e;
    font-weight: 600;
  }

  .location, .role {
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }

  .sep { color: #333; }

  /* gauges */
  .gauge {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .gauge-label {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    color: #555;
    width: 24px;
    flex-shrink: 0;
  }

  .gauge-bar {
    flex: 1;
    height: 4px;
    background: #1a1a28;
    border-radius: 2px;
    overflow: hidden;
  }

  .gauge-fill {
    height: 100%;
    background: #4a4a6a;
    border-radius: 2px;
  }

  .gauge-fill.green  { background: #22c55e; }
  .gauge-fill.accent { background: var(--accent); }

  /* scanner blink */
  .blink {
    color: var(--accent);
    animation: blink 1.2s step-end infinite;
  }

  @keyframes blink {
    0%, 100% { opacity: 1; }
    50%       { opacity: 0; }
  }

  /* top-bar color classes */
  .kitt-title  { color: var(--accent); font-weight: 700; }
  .sys         { color: #4a4a6a; }
  .scanner     { color: #3a3a50; }

  /* Hero buttons */
  .hero-links {
    display: flex;
    gap: 0.8rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .btn-primary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: var(--accent);
    color: #fff;
    padding: 0.6rem 1.3rem;
    border-radius: 5px;
    font-size: 0.88rem;
    font-weight: 500;
    transition: background 0.2s, transform 0.1s;
  }

  .btn-primary:hover {
    background: var(--accent2);
    transform: translateY(-1px);
  }

  .btn-secondary {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: transparent;
    color: var(--text);
    padding: 0.6rem 1.3rem;
    border-radius: 5px;
    font-size: 0.88rem;
    font-weight: 500;
    border: 1px solid var(--border);
    transition: border-color 0.2s, transform 0.1s;
  }

  .btn-secondary:hover {
    border-color: var(--text-muted);
    transform: translateY(-1px);
  }

  /* ── ABOUT ────────────────────────────────── */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 3rem;
    align-items: start;
  }

  .about-text p {
    color: var(--text-muted);
    margin-bottom: 1rem;
    font-size: 0.95rem;
  }

  .about-text p:last-child { margin-bottom: 0; }

  .about-stack { min-width: 160px; }

  .stack-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
    margin-bottom: 0.75rem;
  }

  .stack-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    background: var(--bg2);
    border: 1px solid var(--border);
    padding: 0.2rem 0.55rem;
    border-radius: 4px;
    color: var(--text-muted);
  }

  /* ── CONTACT ──────────────────────────────── */
  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1.5rem;
  }

  .contact-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .contact-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--text-muted);
  }

  .contact-item a {
    font-size: 0.95rem;
    color: var(--text);
    transition: color 0.2s;
  }

  .contact-item a:hover { color: var(--accent); }

  /* ── RESPONSIVE ──────────────────────────── */
  @media (max-width: 640px) {
    .about-grid { grid-template-columns: 1fr; }
    .about-stack { order: -1; }
    .kitt-body {
      grid-template-columns: 1fr;
      gap: 1rem;
    }
    .kitt-sidebar {
      flex-direction: row;
      flex-wrap: wrap;
    }
    .kitt-sidebar.right { order: 3; }
    .kitt-center { order: 2; }
    .gauge { flex-direction: column; align-items: flex-start; gap: 0.2rem; }
    .gauge-label { width: auto; }
    .gauge-bar { width: 100%; }
  }
</style>
