---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Contact · nickdevlab" description="Get in touch with Nick">
  <section>
    <div class="container">
      <p class="section-tag">// CONTACT.FORM</p>
      <h1 class="section-title">Get In Touch</h1>
      <div class="contact-grid">
        <div class="contact-info">
          <div class="panel">
            <div class="panel-header">
              <span class="panel-title">STATUS.CH</span>
              <span class="panel-status"><span class="panel-dot"></span>ONLINE</span>
            </div>
            <div class="panel-body">
              <p class="mono muted" style="font-size: 0.85rem; line-height: 1.7;">
                Available for freelance projects, consulting, or just a conversation about technology.<br/><br/>
                Typical response time: <span class="accent">within 24 hours</span><br/>
                Timezone: <span class="accent">JST (UTC+9)</span>
              </p>
            </div>
          </div>
          <div class="panel" style="margin-top: 1rem;">
            <div class="panel-header"><span class="panel-title">DIRECT.LINK</span></div>
            <div class="panel-body">
              <div class="contact-links">
                <a href="mailto:nick@nickdevlab.com" class="contact-link">
                  <span class="link-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
                  </span>
                  <div>
                    <span class="link-label">Email</span>
                    <span class="link-value">nick@nickdevlab.com</span>
                  </div>
                </a>
                <a href="https://github.com/wongo" target="_blank" rel="noopener" class="contact-link">
                  <span class="link-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.02 10.02 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
                  </span>
                  <div>
                    <span class="link-label">GitHub</span>
                    <span class="link-value">github.com/wongo</span>
                  </div>
                </a>
                <a href="https://t.me/nickwongo" target="_blank" rel="noopener" class="contact-link">
                  <span class="link-icon">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
                  </span>
                  <div>
                    <span class="link-label">Telegram</span>
                    <span class="link-value">@nickwongo</span>
                  </div>
                </a>
              </div>
            </div>
          </div>
        </div>
        <div class="contact-form-wrap">
          <div class="panel">
            <div class="panel-header">
              <span class="panel-title">MESSAGE.IN</span>
              <span class="panel-status"><span class="panel-dot blink"></span>AWAITING</span>
            </div>
            <div class="panel-body">
              <form id="contact-form" class="contact-form">
                <div class="form-group">
                  <label for="name" class="form-label">NAME</label>
                  <input type="text" id="name" name="name" required placeholder="Your name" class="form-input" />
                </div>
                <div class="form-group">
                  <label for="email" class="form-label">EMAIL</label>
                  <input type="email" id="email" name="email" required placeholder="you@example.com" class="form-input" />
                </div>
                <div class="form-group">
                  <label for="subject" class="form-label">SUBJECT</label>
                  <input type="text" id="subject" name="subject" required placeholder="What is this about?" class="form-input" />
                </div>
                <div class="form-group">
                  <label for="message" class="form-label">MESSAGE</label>
                  <textarea id="message" name="message" rows="5" required placeholder="Your message..." class="form-input form-textarea"></textarea>
                </div>
                <button type="submit" class="form-submit" id="submit-btn">
                  <span id="btn-text">TRANSMIT MESSAGE</span>
                  <span id="btn-loading" class="hidden">SENDING...</span>
                </button>
                <div id="form-status" class="form-status hidden"></div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // EmailJS integration — replace the placeholder values below
  // Sign up at https://www.emailjs.com and get your:
  //   - Public Key (user ID)
  //   - Service ID
  //   - Template ID
  // Then update the three 'YOUR_...' values in this script.
  (function(){
    // eslint-disable-next-line @typescript-eslint/no-explicit-any
    (window as any).emailjs || (function(){
      const script = document.createElement('script');
      script.src = 'https://cdn.jsdelivr.net/npm/@emailjs/browser@4/dist/email.min.js';
      document.head.appendChild(script);
      script.onload = () => {
        // eslint-disable-next-line @typescript-eslint/no-explicit-any
        (window as any).emailjs.init('YOUR_EMAILJS_PUBLIC_KEY');
      };
    })();
  })();

  const form = document.getElementById('contact-form') as HTMLFormElement;
  const submitBtn = document.getElementById('submit-btn') as HTMLButtonElement;
  const btnText = document.getElementById('btn-text')!;
  const btnLoading = document.getElementById('btn-loading')!;
  const formStatus = document.getElementById('form-status')!;

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btnText.classList.add('hidden');
    btnLoading.classList.remove('hidden');
    submitBtn.disabled = true;
    try {
      // eslint-disable-next-line @typescript-eslint/no-explicit-any
      await (window as any).emailjs.sendForm(
        'YOUR_EMAILJS_SERVICE_ID',
        'YOUR_EMAILJS_TEMPLATE_ID',
        form
      );
      formStatus.textContent = '// MESSAGE TRANSMITTED SUCCESSFULLY';
      formStatus.className = 'form-status success';
      form.reset();
    } catch (err) {
      formStatus.textContent = '// TRANSMISSION FAILED. TRY AGAIN.';
      formStatus.className = 'form-status error';
    } finally {
      btnText.classList.remove('hidden');
      btnLoading.classList.add('hidden');
      submitBtn.disabled = false;
      formStatus.classList.remove('hidden');
    }
  });
</script>

<style>
.contact-grid {
  display: grid;
  grid-template-columns: 340px 1fr;
  gap: 2rem;
  align-items: start;
}

.contact-links { display: flex; flex-direction: column; gap: 0.75rem; }

.contact-link {
  display: flex;
  align-items: center;
  gap: 0.85rem;
  padding: 0.5rem;
  border-radius: var(--radius);
  transition: background 0.2s;
}
.contact-link:hover { background: var(--bg2); }

.link-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 34px;
  height: 34px;
  background: var(--bg2);
  border: 1px solid var(--border2);
  border-radius: var(--radius);
  color: var(--accent);
  flex-shrink: 0;
}

.contact-link > div { display: flex; flex-direction: column; gap: 0.05rem; }

.link-label {
  font-family: var(--font-mono);
  font-size: 0.65rem;
  color: var(--text-muted);
  letter-spacing: 0.08em;
}

.link-value { font-size: 0.85rem; color: var(--text); }

.contact-form { display: flex; flex-direction: column; gap: 1.25rem; }

.form-group { display: flex; flex-direction: column; gap: 0.4rem; }

.form-label {
  font-family: var(--font-mono);
  font-size: 0.68rem;
  color: var(--accent);
  letter-spacing: 0.1em;
}

.form-input {
  background: var(--bg2);
  border: 1px solid var(--border2);
  border-radius: var(--radius);
  padding: 0.65rem 0.9rem;
  font-family: var(--font-mono);
  font-size: 0.88rem;
  color: var(--text);
  outline: none;
  transition: border-color 0.2s, box-shadow 0.2s;
  width: 100%;
}

.form-input::placeholder { color: var(--text-muted); opacity: 0.5; }
.form-input:focus {
  border-color: var(--accent);
  box-shadow: 0 0 0 2px rgba(230, 57, 70, 0.15);
}

.form-textarea { resize: vertical; min-height: 120px; }

.form-submit {
  background: var(--accent);
  color: #fff;
  border: none;
  border-radius: var(--radius);
  padding: 0.75rem 1.5rem;
  font-family: var(--font-mono);
  font-size: 0.82rem;
  font-weight: 600;
  letter-spacing: 0.08em;
  cursor: pointer;
  transition: background 0.2s, transform 0.1s;
  align-self: flex-start;
}

.form-submit:hover { background: var(--accent2); }
.form-submit:active { transform: scale(0.98); }
.form-submit:disabled { opacity: 0.6; cursor: not-allowed; }

.hidden { display: none; }

.form-status {
  font-family: var(--font-mono);
  font-size: 0.8rem;
  padding: 0.6rem 0.9rem;
  border-radius: var(--radius);
}

.form-status.success {
  color: #4ade80;
  background: rgba(74, 222, 128, 0.08);
  border: 1px solid rgba(74, 222, 128, 0.2);
}

.form-status.error {
  color: var(--accent);
  background: rgba(230, 57, 70, 0.08);
  border: 1px solid rgba(230, 57, 70, 0.2);
}

@media (max-width: 768px) {
  .contact-grid { grid-template-columns: 1fr; }
}
</style>
