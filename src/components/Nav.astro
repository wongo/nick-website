<---
// Nav — Sticky navigation with scanner bar
---
<div class="nav-wrapper">
  <!-- Scanner beam bar -->
  <div class="top-scanner">
    <span class="scanner-label">K.N.I.T.T. NETWORK</span>
    <div class="scanner-track">
      <div class="scanner-beam"></div>
    </div>
    <span class="scanner-status">INTERFACE: ACTIVE</span>
  </div>

  <!-- Nav links -->
  <nav class="nav-inner">
    <a href="/" class="logo">
      <span class="logo-bracket">[</span>nick<span class="logo-bracket">]</span>
    </a>
    <div class="nav-links">
      <a href="/about">About</a>
      <a href="/projects">Projects</a>
      <a href="/blog">Blog</a>
      <a href="/contact">Contact</a>
    </div>
    <div class="nav-status">
      <span class="status-dot"></span>
      <span class="status-text">ONLINE</span>
    </div>
  </nav>
</div>

<style>
.nav-wrapper {
  position: sticky;
  top: 0;
  z-index: 100;
}

/* Top scanner bar */
.top-scanner {
  display: flex;
  align-items: center;
  gap: 0.75rem;
  padding: 0.3rem 1.5rem;
  background: var(--bg2);
  border-bottom: 1px solid var(--border);
}

.scanner-label {
  font-family: var(--font-mono);
  font-size: 0.58rem;
  color: var(--accent);
  letter-spacing: 0.12em;
  white-space: nowrap;
}

.scanner-status {
  font-family: var(--font-mono);
  font-size: 0.58rem;
  color: var(--text-muted);
  letter-spacing: 0.08em;
  white-space: nowrap;
}

.scanner-track {
  flex: 1;
  height: 2px;
  background: var(--border);
  border-radius: 1px;
  overflow: hidden;
}

.scanner-beam {
  position: absolute;
  top: 0;
  left: -25%;
  width: 20%;
  height: 100%;
  background: linear-gradient(90deg, transparent, var(--accent), transparent);
  border-radius: 1px;
  animation: scan 3s linear infinite;
}

@keyframes scan {
  0%   { left: -25%; opacity: 0; }
  5%   { opacity: 1; }
  95%  { opacity: 1; }
  100% { left: 100%; opacity: 0; }
}

/* Nav */
.nav-inner {
  display: flex;
  align-items: center;
  justify-content: space-between;
  max-width: var(--max-w);
  margin: 0 auto;
  padding: 0.9rem 1.5rem;
  background: rgba(10, 10, 15, 0.9);
  backdrop-filter: blur(12px);
  border-bottom: 1px solid var(--border);
}

.logo {
  font-family: var(--font-mono);
  font-size: 1rem;
  font-weight: 600;
  color: var(--text);
  letter-spacing: -0.02em;
}

.logo-bracket {
  color: var(--accent);
}

.logo:hover {
  color: var(--text);
}

.nav-links {
  display: flex;
  gap: 2.2rem;
}

.nav-links a {
  font-family: var(--font-mono);
  font-size: 0.82rem;
  color: var(--text-muted);
  letter-spacing: 0.04em;
  transition: color 0.2s;
}

.nav-links a:hover {
  color: var(--accent);
}

.nav-status {
  display: flex;
  align-items: center;
  gap: 0.4rem;
}

.status-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: var(--green);
  animation: blink 2s ease-in-out infinite;
}

@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.25; }
}

.status-text {
  font-family: var(--font-mono);
  font-size: 0.62rem;
  color: var(--green);
  letter-spacing: 0.1em;
}

@media (max-width: 600px) {
  .nav-links { gap: 1.2rem; }
  .scanner-label, .scanner-status { display: none; }
  .nav-status { display: none; }
}
</style>
